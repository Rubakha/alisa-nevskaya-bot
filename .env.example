# ─── ОБЯЗАТЕЛЬНЫЕ ───────────────────────────────────────────
# Токен от @BotFather
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram chat_id (узнать: @userinfobot)
ADMIN_ID=991276518

# Провайдер оплаты: @BotFather -> твой бот -> Payments -> ЮKassa -> подключить.
# Без него кнопка оплаты в боте не работает.
YOOKASSA_PROVIDER_TOKEN=

# ─── ДЛЯ RENDER ─────────────────────────────────────────────
# Адрес сервиса без слэша на конце. Локально оставь пустым —
# бот запустится в режиме polling.
WEBHOOK_URL=https://alisa-bot.onrender.com

# Путь к постоянному диску. На Render: /var/data
# Локально можно не задавать — будет ./data
DATA_DIR=/var/data

PORT=5000

# ─── НАСТРОЙКИ ──────────────────────────────────────────────
# Имя бота без @ — из него собираются реферальные ссылки
BOT_USERNAME=alisanevskaya_letters_bot

# Автобэкап в чат админу: 168 = раз в неделю, 24 = ежедневно, 0 = выключить
BACKUP_EVERY_HOURS=168

# ─── CLAUDE-ПОМОЩНИК (необязательно) ────────────────────────
# Без ключа бот работает как обычно, кнопки помощника скрыты.
# Ключ: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модели: быстрая для разборов, глубокая для черновиков писем
AI_MODEL_FAST=claude-sonnet-4-5
AI_MODEL_DEEP=claude-sonnet-4-5

# Голосовое письмо (без ключа функция скрыта)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_F=
ELEVENLABS_VOICE_ID_M=
